# ─────────────────────────────────────────────────────────────
# ModelContract environment variables
# Copy to `.env.local` (apps/web) / `.env` (root) as needed.
# No secrets in this repository — never commit real credentials.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (used from Stage 2 — packages/db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modelcontract?schema=public"

# Bright Data Scraper Studio (used from Stage 2 — packages/brightdata)
# Account ID + API token for api.brightdata.com
BRIGHTDATA_ACCOUNT_ID=""
BRIGHTDATA_API_TOKEN=""

# Collector for the controlled demo provider (Stage 2)
BRIGHTDATA_COLLECTOR_ID=""

# Collector for the real public AI-provider source (Stage 2)
BRIGHTDATA_REAL_COLLECTOR_ID=""
