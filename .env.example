[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# ModelContract environment variables
# Copy to `.env.local` (apps/web) / `.env` (root) as needed.
# No secrets in this repository — never commit real credentials.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (packages/db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modelcontract?schema=public"

# Bright Data Scraper Studio API token (packages/brightdata)
# https://brightdata.com — Profile → API tokens → create a token
BRIGHT_DATA_API_TOKEN=""

# Published Scraper Studio collector for the controlled demo provider.
# Input schema: [{ "url": "http://<host>/provider-demo/model-x" }]
BRIGHT_DATA_DEMO_COLLECTOR_ID=""

# Published Scraper Studio collector for the real public AI-provider source
# (Anthropic Models Overview). Input schema: [{ "url": "https://platform.claude.com/docs/en/about-claude/models/overview" }]
BRIGHT_DATA_REAL_COLLECTOR_ID=""
