// ModelContract — Stage 2 persistence schema.
// Six entities only: Provider, Model, Contract, Observation, CollectorVersion,
// DemoState. DriftEvent / HealAttempt / CompatibilityCheck arrive with their
// owning later stages (3/4/6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provider {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  models    Model[]
}

model Model {
  id          String        @id @default(cuid())
  providerId  String
  modelId     String
  displayName String?
  createdAt   DateTime      @default(now())
  provider    Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  contracts   Contract[]
  observations Observation[]

  @@unique([providerId, modelId])
}

// One "current contract" row per model; updated on every schema-valid
// observation. History lives in Observation rows.
model Contract {
  id               String   @id @default(cuid())
  modelId          String
  status           String
  contextWindow    Int?
  inputPrice       Float?
  outputPrice      Float?
  currency         String   @default("USD")
  pricingUnit      String   @default("per_1m_tokens")
  deprecationDate  String?
  semanticHash     String
  sourceUrl        String
  collectorId      String
  collectorVersion String
  observedAt       String
  createdAt        DateTime @default(now())
  model            Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId])
}

model Observation {
  id                 String   @id @default(cuid())
  modelId            String
  rawPayload         Json
  normalizedPayload  Json?
  schemaValid        Boolean
  validationErrors   Json
  validationWarnings Json
  semanticHash       String?
  collectorId        String
  collectorVersion   String?
  runId              String?
  sourceUrl          String
  observedAt         String
  createdAt          DateTime @default(now())
  model              Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model CollectorVersion {
  id          String   @id @default(cuid())
  collectorId String
  version     String
  sourceName  String
  status      String   @default("active")
  createdAt   DateTime @default(now())

  @@unique([collectorId, version])
}

// Singleton row (id = "singleton") holding the controlled provider's current
// demo variant, so /provider-demo/model-x mutates under a stable URL.
model DemoState {
  id        String   @id
  variant   String
  updatedAt DateTime @updatedAt
}
